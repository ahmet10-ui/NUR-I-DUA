# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OPTIONAL SERVER-SIDE TURKISH NEURAL TTS PROVIDERS (Keep keys strictly on server)
# Option A: Azure Cognitive Speech (Free F0 tier or Pay-as-you-go; tr-TR-AhmetNeural)
# AZURE_SPEECH_KEY=""
# AZURE_SPEECH_REGION="westeurope"
#
# Option B: Self-Hosted Piper Open-Source Turkish Male TTS (Free, offline)
# PIPER_TTS_URL="http://127.0.0.1:5000"
#
# Option C: ElevenLabs Multilingual v2
# ELEVENLABS_API_KEY=""
# ELEVENLABS_VOICE_ID=""
#
# Option D: Custom HTTP Neural TTS Microservice
# CUSTOM_TTS_URL=""
# CUSTOM_TTS_TOKEN=""

# OPTIONAL SERVER-SIDE TIKTOK RELAY SIGNING CONFIGURATION (relay-server/ only)
# Never expose signer URLs or tokens to the frontend client.
# WS_SIGN_SERVER_URL=""       # Custom WebSocket fetch/sign endpoint (RouteConfig.fetchSignedWebSocketFromProvider)
# HTTP_SIGN_SERVER_URL=""     # Custom HTTP URL sign endpoint (RouteConfig.fetchWebcastSignatureFromProvider)
# SIGN_SERVER_URL=""          # Base or WS signer URL fallback
# SIGN_SERVER_TOKEN=""        # Optional Bearer/x-api-key header sent strictly to external signer server
# DISABLE_EULER="false"       # Set true to block all EulerStream calls when running purely self-hosted signers
