# NUR-I DUA — Harici TikTok LIVE Relay Sunucusu Örnek Ortam Değişkenleri
# Gerçek sırları/anahtarları Git deposuna eklemeyin; Render > Environment bölümüne girin.

PORT=8080
HOST=0.0.0.0
TIKTOK_USERNAME=fcproplayer7
SIMULATION_ENABLED=false

# Modüler İmzalama Sağlayıcısı:
#   auto          -> Ayarlı uç noktalara göre otomatik seçer
#   custom_full   -> Hem WS_SIGN_SERVER_URL hem HTTP_SIGN_SERVER_URL kullanır (Euler kapalı)
#   custom_ws     -> Harici WS imzalama sunucusu kullanır (Euler kapalı)
#   custom_http   -> Harici HTTP imzalama sunucusu ile doğrudan imzalı im/fetch yapar (Euler kapalı)
#   tiktok_signer -> nglmercer/tiktok-signer HTTP JSON servisi (Euler kapalı)
#   euler         -> Yalnızca EulerStream ücretsiz WS rotası (kotaya tabidir)
#   none          -> Euler tamamen kapalı; özel imzalayıcı zorunlu
TIKTOK_SIGNER_PROVIDER=auto

# nglmercer/tiktok-signer veya özel HTTP imzalayıcı kullanıyorsanız:
# HTTP_SIGN_SERVER_URL=https://ornek-imzalayici.internal/sign
# WS_SIGN_SERVER_URL=
# SIGN_SERVER_URL=
# SIGN_SERVER_HTTP_METHOD=POST
# SIGN_SERVER_TOKEN=
# SIGN_SERVER_TIMEOUT_MS=15000

# EulerStream tamamen devre dışı bırakılsın mı? (true önerilir eğer harici signer varsa)
DISABLE_EULER=false

# Euler Business (/webcast/sign_url) ucu varsayılan olarak ENGELLİDİR.
ALLOW_EULER_BUSINESS_SIGN=false
# SIGN_API_KEY=
